# Universal AI Gateway — nginx 反向代理示例（spec/12 §3.2，形态 C：域名对外）
#
# 这是一个 server 块片段，放进 http { } 中（例如 /etc/nginx/conf.d/uaig.conf）。
# 前提：
#   - gateway.yaml 中 server.data_listen: "127.0.0.1:8080"（DEP-01）
#   - gateway.yaml 中 server.trusted_proxies: ["127.0.0.1/32", "::1/128"]（DEP-02）
#   - 证书已用 certbot 等工具申请到下面的路径
#
# 校验：nginx -t

server {
    listen 443 ssl http2;
    server_name gateway.example.com;
    ssl_certificate     /etc/letsencrypt/live/gateway.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gateway.example.com/privkey.pem;

    client_max_body_size 32m;            # 与 limits.max_request_body_bytes（默认 32 MiB）一致

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;             # 必须：否则 SSE 流会被攒成整块再发送
        proxy_request_buffering off;
        proxy_read_timeout 900s;         # 长流式响应；同步封装的长任务需 >= 池的 response_header_base
        proxy_send_timeout 900s;
    }

    # 接入文件上传类 API（BodyStream 路由，如 MinerU）时，只对上传路径放宽请求体上限，
    # 与 limits.max_stream_body_bytes（默认 512 MiB）一致；proxy_request_buffering off
    # 避免 nginx 先把整个文件落盘再转发：
    #
    # location ~ ^/v1/(parse|tasks)$ {   # MinerU 的两个上传端点
    #     proxy_pass http://127.0.0.1:8080;
    #     proxy_http_version 1.1;
    #     proxy_set_header Connection "";
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     client_max_body_size 512m;
    #     proxy_request_buffering off;
    #     proxy_buffering off;
    #     proxy_read_timeout 900s;
    #     proxy_send_timeout 900s;
    # }
}

# 可选：HTTP 80 端口自动重定向到 HTTPS
# server {
#     listen 80;
#     server_name gateway.example.com;
#     return 301 https://$host$request_uri;
# }
