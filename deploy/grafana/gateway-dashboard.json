    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 300,
      "panels": [],
      "title": "Key Pool & Upstream",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Distribution of upstream API keys across states: available (ready), cooling (cooldown), and exhausted/breaker_open.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pool) (uaig_keys_status{pool=~\"$pool\",state=\"ready\"}) or sum by (pool) (uai_keys_total{pool=~\"$pool\",status=\"available\"})",
          "legendFormat": "{{pool}} - ready (available)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pool) (uaig_keys_status{pool=~\"$pool\",state=\"cooldown\"}) or sum by (pool) (uai_keys_total{pool=~\"$pool\",status=\"cooling\"})",
          "legendFormat": "{{pool}} - cooldown (cooling)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pool) (uaig_keys_status{pool=~\"$pool\",state=\"breaker_open\"}) or sum by (pool) (uai_circuit_breaker_tripped{pool=~\"$pool\"})",
          "legendFormat": "{{pool}} - breaker open",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pool) (uaig_keys_status{pool=~\"$pool\",state=~\"quarantined|disabled\"}) or sum by (pool) (uai_keys_total{pool=~\"$pool\",status=~\"quarantined|disabled|exhausted\"})",
          "legendFormat": "{{pool}} - quarantined / disabled",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Key States by Pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current concurrency and in-flight request count per key pool and individual upstream key.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pool) (uaig_key_inflight{pool=~\"$pool\"}) or sum by (pool) (uai_keys_in_flight{pool=~\"$pool\"})",
          "legendFormat": "Pool Total: {{pool}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(uaig_key_inflight{pool=~\"$pool\"} > 0) or (uai_keys_in_flight{pool=~\"$pool\"} > 0)",
          "legendFormat": "{{pool}} - Key {{name}} (id: {{id}}{{key_id}})",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "In-Flight Requests per Pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Circuit breaker trip events and global overload shed events across upstream pools.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*breaker.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2495C",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*shed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#FF9830",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "id": 10,
      "options": {
